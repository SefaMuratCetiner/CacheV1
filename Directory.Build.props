<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      CA2007 (ConfigureAwait): ASP.NET Core has no synchronization context.
      CA1515 (make types internal): FastEndpoints endpoints and DTOs are public by design.
      CA1062 (validate public arguments): nullable reference types already cover this.
    -->
    <NoWarn>$(NoWarn);CA2007;CA1515;CA1062</NoWarn>
  </PropertyGroup>
</Project>
